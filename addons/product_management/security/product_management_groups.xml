<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_product_management">
        <field name="name">Product Management</field>
        <field name="sequence">10</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_product_management">
        <field name="name">Product Management</field>
        <field name="category_id" ref="product_management.module_category_product_management"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_product_management_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="product_management.res_groups_privilege_product_management"/>
    </record>

    <record id="group_product_management_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="product_management.res_groups_privilege_product_management"/>
        <field name="implied_ids" eval="[(4, ref('group_product_management_viewer'))]"/>
    </record>
</odoo>
